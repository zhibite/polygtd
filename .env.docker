###############################################################################
# Polymarket BTC 15m GTD bot — Docker / Coolify 非敏感配置
#
# 重要：
#   - 本文件会提交到 git，并被打进 Docker 镜像（程序会把它作为备用 env
#     文件读取）。**不要把密钥写在这里。**
#   - API_KEY / API_SECRET / API_PASSPHRASE（或 WALLET_PRIVATE_KEY /
#     SIGNATURE_TYPE / FUNDER_ADDRESS）请在 Coolify 面板的环境变量里设置。
#     进程环境变量优先级最高，会覆盖本文件中的同名项。
#   - 本地 docker compose 调试时，密钥可放在未提交的本地 .env，或使用
#     `docker compose run -e API_KEY=...` 传入。
#
# 读取优先级：进程环境变量 > .env > .env.docker > 代码默认值
# config.toml 里的 GENERAL / BINANCE / BASELINE / LOG 请直接改 config.toml。
###############################################################################

# ── 凭证：请在 Coolify 面板设置，不要写在这里 ────────────────────────────
# 方式 A（推荐）：L2 API Key
API_KEY=
API_SECRET=
API_PASSPHRASE=
# 方式 B：私钥派生（与方式 A 二选一；同样在 Coolify 面板设置）
# WALLET_PRIVATE_KEY=
# SIGNATURE_TYPE=0            # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
# FUNDER_ADDRESS=             # SIG_TYPE=1/2 必填：真正持有 pUSD 的代理/Safe 地址

# ── CLOB / Gamma 端点（一般无需修改）────────────────────────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com   # 当前未使用，可保留

# ── 马丁格尔层级（USD 名义，合计最大暴露 1+2+4+8 = 15 USD）─────────────
# T1 用 taker 市价单入场（1 USD 不足 5 股，不能挂 GTD）；T2-T4 仍是 maker GTD
TIER1_NOTIONAL=1.0
TIER2_NOTIONAL=2.0
TIER3_NOTIONAL=4.0
TIER4_NOTIONAL=8.0

# ── 入场 / 加仓 ─────────────────────────────────────────────────────────
ENTRY_PRICE_CAP=0.40
TIER2_DROP_PCT=0.20
TIER3_DROP_PCT=0.40
TIER4_DROP_PCT=0.60
PRICE_PRE_MARGIN=0.10
# 撤单滞回：撤单线比挂单线多走 2%，避免 mid 在阈值附近抖动时反复挂撤
CANCEL_HYSTERESIS_PCT=0.02
# 止盈是否也受 BTC 漂移门限制（false = 止盈只看价格触发线，不因 BTC 漂移被挡住）
TP_REQUIRE_DRIFT_GATE=false

# ── 止盈 ────────────────────────────────────────────────────────────────
TP_PROFIT_PCT=0.20
TP_DECREMENT_PCT=0.03
TP_MIN_PCT=0.05

# ── 风控 ────────────────────────────────────────────────────────────────
BASELINE_DRIFT_LIMIT=0.0015
T1_ENTRY_WINDOW_S=300
CROSS_WINDOW_DRIFT_SKIP_PCT=0.5
SKIP_IF_LATE_WINDOW_AT_BOOT=true
ENTRY_OPEN_OFFSET_GRACE_SEC=180
# BTC 行情健康 / 急涨急跌守卫（0 = 关闭）
BTC_STALE_MAX_AGE_S=5
BTC_VOL_WINDOW_S=60
BTC_VOL_MAX_MOVE_PCT=0.3
BTC_VOL_COOLDOWN_S=60
# T4 漂移豁免：窗口剩余 ≥ 9 分钟时 T4 可在 BTC 漂移 FAIL 下补仓；0=关闭
T4_DRIFT_BYPASS_MIN_REMAINING_S=540

# T4 入场闸门（8u 是最大的一层，避免在趋势中越补越深）
# 剩余时间不足 240s 不补；BTC 距开盘价 z 分数 >2 不补；mid 已跌破触发价
# 5% 以上不挂单（等回到预挂区）。
T4_MIN_REMAINING_S=240
T4_STRIKE_GATE_ENABLED=true
T4_MAX_STRIKE_Z=2.0
T4_STRIKE_SIGMA_PCT_PER_MIN=0.05
T4_MAX_GAP_BELOW_TRIGGER_PCT=0.05

# T4 入场/出场决策 JSONL 日志：默认 <项目根>/data/t4_journal.jsonl
# （容器内为 /app/data/t4_journal.jsonl）。记录 T4 决策的 z/剩余时间/
# 波动率、T4 成交、止盈/止损成交、回合结算，用于长期回看调参。
# 注意：/app/data 目前没有持久卷，重新部署会丢失；要跨部署积累请先挂卷。
T4_JOURNAL_ENABLED=true
# T4_JOURNAL_PATH=/app/data/t4_journal.jsonl

# T4 成交后的两段式止损
STOP_LOSS_ENABLED=true
STOP_LOSS_T4_DROP_PCT=0.45
STOP_LOSS_CONFIRM_S=20
STOP_LOSS_STAGE1_SELL_PCT=0.60
STOP_LOSS_STAGE2_EXTRA_DROP_PCT=0.30
STOP_LOSS_TIME_EXIT_S=120
STOP_LOSS_FLOOR=0.05
STOP_LOSS_FINAL_EXIT_S=60
STOP_LOSS_FINAL_MID=0.50

# ── 订单 / GTD ──────────────────────────────────────────────────────────
GTD_LIFETIME_S=300
# Taker 手续费率（官方公式 fee = C×feeRate×p×(1-p)，maker 免费；Crypto=0.07）
TAKER_FEE_RATE=0.07
TIER_WATCHER_POLL_S=1.5
SELL_SLIPPAGE_PCT=0.02

# ── GTD 安全开关（实盘建议保持）─────────────────────────────────────────
VERIFY_NO_EXISTING_ORDER=true
# 专用钱包保持 true；同一 API Key / Safe 还跑着其它机器人或手工单时改 false。
STARTUP_RECONCILE_CANCEL_ALL=true

# ── 可选：数据路径 ──────────────────────────────────────────────────────
# 默认 <项目根目录>/data/polymarket.db；Docker 镜像内为 /app/data/polymarket.db。
# 注意：这两项由 db.py 直接读 os.getenv，写入本文件不会生效；需要时请在
# Coolify 面板的 Environment Variables 中设置。
# POLYMARKET_DATA_DIR=/app/data
# POLYMARKET_DB_PATH=/app/data/polymarket.db

# ── Web 看板（FastAPI，监听 8010）───────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8010
# 公网域名务必设置密码。密钥不要提交，放在 Coolify 面板的环境变量里。
# 登录会话有效期（秒），默认 7 天；重启后需要重新登录。
# WEB_SESSION_TTL_S=604800
# WEB_USERNAME=admin
# WEB_PASSWORD=
