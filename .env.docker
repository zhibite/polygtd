# Polymarket GTD Bot Docker Environment
# Copy from .env.example and fill in your values.

# ── Polymarket CLOB Endpoints (usually no need to change) ──────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# ── Wallet Credentials ───────────────────────────────────────────────────
# Option A: provide all three L2 API credentials directly (recommended)
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Option B: provide private key + wallet address (key will be derived at startup)
# WALLET_PRIVATE_KEY=0x...
# WALLET_ADDRESS=0x...
# SIGNATURE_TYPE=0   # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
# ────────────────────────────────────────────────────────────────────────
# H-V6-11: FUNDER_ADDRESS is the wallet that holds the funds and signs
# trades. For SIG_TYPE=0 (EOA) leave it blank and it auto-falls-back to
# the EOA derived from WALLET_PRIVATE_KEY. For SIG_TYPE=1 (POLY_PROXY)
# / 2 (GNOSIS_SAFE) / 3 (POLY_1271) set it to the proxy / Safe /
# deposit-wallet address — without this the CLOB rejects every order
# with "maker address not allowed, please use the deposit wallet flow".
# See sibling project D:\05.project2\1.bquant\polymart3 for a working
# setup using FUNDER_ADDRESS=<your Safe address> with SIGNATURE_TYPE=2.
# FUNDER_ADDRESS=

# ── Martingale Tiers (USD notional per tier) ──────────────────────────────
# H-NEW-2026-07-11-4: 3-tier cap (T1 entry + T2/T3 averaging). Max exposure 14 USD.
TIER1_NOTIONAL=2.0
TIER2_NOTIONAL=4.0
TIER3_NOTIONAL=8.0
# Per-tier hard cap multiplier over planned notional. Tier is considered
# saturated when its cost_filled exceeds planned * TIER_NOTIONAL_MAX_MULT
# and the engine will refuse to re-place it (kills GTD loops / over-fill).
TIER_NOTIONAL_MAX_MULT=1.1

# ── Strategy Thresholds ──────────────────────────────────────────────────
# H-NEW-2026-07-11-5: tightened entry cap from 0.40 → 0.36.
ENTRY_PRICE_CAP=0.36
TIER2_DROP_PCT=0.30
TIER3_DROP_PCT=0.60
TP_PROFIT_PCT=0.20
# H-NEW-2026-07-11-5: TP decrement 3% → 5%. N=1 → 15%, N=2 → 10%.
TP_DECREMENT_PCT=0.05
BASELINE_DRIFT_LIMIT=0.0015
T1_ENTRY_WINDOW_S=300

# ── Order Settings ────────────────────────────────────────────────────────
GTD_LIFETIME_S=180
SELL_SLIPPAGE_PCT=0.02
