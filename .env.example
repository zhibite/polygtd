###############################################################################
# Polymarket BTC 15m Up/Down bot — Environment Variables
# Copy this file to .env and fill in your values.
###############################################################################

# ── Polymarket CLOB Endpoints (usually no need to change) ──────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# ── Wallet Credentials ─────────────────────────────────────────────────────
# Option A: provide all three L2 API credentials directly (recommended)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Option B: provide private key + address (key will be derived at startup)
# POLY_PRIVATE_KEY=0x...
# POLY_WALLET_ADDRESS=0x...
# SIGNATURE_TYPE=0   # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE

# ── Martingale Tiers (USD notional per tier) ──────────────────────────────
TIER1_NOTIONAL=2.0
TIER2_NOTIONAL=2.0
TIER3_NOTIONAL=4.0
TIER4_NOTIONAL=8.0

# ── Strategy Thresholds ───────────────────────────────────────────────────
# Max token price to enter (either UP or DOWN)
ENTRY_PRICE_CAP=0.40
# Averaging-down trigger thresholds relative to baseline (T1 avg fill price)
TIER2_DROP_PCT=0.20
TIER3_DROP_PCT=0.40
TIER4_DROP_PCT=0.60
# Take-profit target as fraction of average cost
TP_PROFIT_PCT=0.20
# Max BTC spot drift relative to round-start baseline (0.0015 = 0.15%)
BASELINE_DRIFT_LIMIT=0.0015
# T1 entry time gate: must enter within this many seconds of window open
T1_ENTRY_WINDOW_S=300

# ── Order Settings ────────────────────────────────────────────────────────
# GTD lifetime in seconds (must be >= 180 per CLOB rule)
GTD_LIFETIME_S=180
# Slippage for FAK sell orders (0.02 = 2%)
SELL_SLIPPAGE_PCT=0.02
