###############################################################################
# Polymarket BTC 15m GTD bot — 实盘环境变量模板
#
# 使用：
#   cp .env.example .env
#   编辑 .env 填入凭证与参数（.env 已被 .gitignore 忽略，不会提交）
#
# 说明：
#   - 必填：凭证二选一（方式 A 或 方式 B）
#   - 其余项均有默认值；实盘前请逐项确认
#   - config.toml 中的 GENERAL / BINANCE / BASELINE / LOG 请直接改 config.toml
#
# Docker / Coolify 部署：
#   - 非敏感配置放在 .env.docker（已随仓库提供，会打进镜像并由程序读取）
#   - 密钥请放在 Coolify 面板的 Environment Variables（或宿主机环境变量 /
#     本地未提交的 .env），进程环境变量优先级最高，会覆盖 .env.docker
#   - 本文件仅用于本地 `python -m src.main` 的 .env 模板
###############################################################################

# ── 凭证方式 A（推荐）：直接使用 L2 API Key ──────────────────────────────
# 三个都必须填写；缺 passphrase 时 CLOB 无法完成 L2 签名。
API_KEY=
API_SECRET=
API_PASSPHRASE=

# ── 凭证方式 B：从私钥在启动时派生 L2 凭证（与方式 A 二选一）────────────
# WALLET_PRIVATE_KEY=0x...
# SIGNATURE_TYPE=0              # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
# FUNDER_ADDRESS=               # SIG_TYPE=1/2 必填：真正持有 pUSD 的代理/Safe 地址
#                               # 漏填会被 CLOB 以 "maker address not allowed" 拒绝
# 注意：WALLET_ADDRESS 当前未使用（EOA 地址由私钥自动推导）

# ── CLOB / Gamma 端点（一般无需修改）────────────────────────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com   # 当前未使用，可保留

# ── 马丁格尔层级（USD 名义，合计最大暴露 1+2+4+8 = 15 USD）─────────────
# T1 用 taker 市价单入场（1 USD 不足 5 股，不能挂 GTD）；T2-T4 仍是 maker GTD
TIER1_NOTIONAL=1.0
TIER2_NOTIONAL=2.0
TIER3_NOTIONAL=4.0
TIER4_NOTIONAL=8.0

# ── 入场 / 加仓 ─────────────────────────────────────────────────────────
ENTRY_PRICE_CAP=0.40            # T1 挂单价上限
TIER2_DROP_PCT=0.20             # 相对 T1 实际成交均价下跌 20%
TIER3_DROP_PCT=0.40
TIER4_DROP_PCT=0.60
PRICE_PRE_MARGIN=0.10           # 提前挂单余量：BUY 在 mid <= 价*1.10 时预挂
CANCEL_HYSTERESIS_PCT=0.02      # 撤单滞回：撤单线比挂单线多走 2%，抑制挂撤抖动
TP_REQUIRE_DRIFT_GATE=false     # 止盈是否也受 BTC 漂移门限制（推荐 false）

# ── 止盈 ────────────────────────────────────────────────────────────────
TP_PROFIT_PCT=0.20              # 基础止盈：成本 +20%
TP_DECREMENT_PCT=0.03           # 每成交一层加仓减 3% -> 20/17/14/11%
TP_MIN_PCT=0.05                 # 止盈下限 5%

# ── 风控 ────────────────────────────────────────────────────────────────
BASELINE_DRIFT_LIMIT=0.0015     # BTC 相对窗口开盘价漂移上限 0.15%
T1_ENTRY_WINDOW_S=300           # 仅窗口开启后 5 分钟内允许 T1
CROSS_WINDOW_DRIFT_SKIP_PCT=0.5 # 跨窗跳空 >0.5% 跳过该窗；0=关闭
SKIP_IF_LATE_WINDOW_AT_BOOT=true
ENTRY_OPEN_OFFSET_GRACE_SEC=180
BTC_STALE_MAX_AGE_S=5           # Binance 行情超过 5s 未更新 → 暂停开仓/补仓
BTC_VOL_WINDOW_S=60             # 急涨急跌检测窗口 60s
BTC_VOL_MAX_MOVE_PCT=0.3        # 窗口内振幅 >0.3% → 暂停开仓/补仓并撤买单
BTC_VOL_COOLDOWN_S=60           # 触发后冷却 60s
T4_DRIFT_BYPASS_MIN_REMAINING_S=540  # 窗口剩余 ≥9 分钟时 T4 可豁免 BTC 漂移门

# T4 成交后的两段式止损
STOP_LOSS_ENABLED=true
STOP_LOSS_T4_DROP_PCT=0.45           # T4 成交价再跌 45% 触发第一段
STOP_LOSS_CONFIRM_S=20               # 持续低于触发线 20s 才卖
STOP_LOSS_STAGE1_SELL_PCT=0.60       # 第一段卖出 60%
STOP_LOSS_STAGE2_EXTRA_DROP_PCT=0.30 # 第一段触发线再跌 30% → 清剩余
STOP_LOSS_TIME_EXIT_S=120            # 剩余 ≤2 分钟且 mid ≤0.05 → 清剩余
STOP_LOSS_FLOOR=0.05
STOP_LOSS_FINAL_EXIT_S=60            # 最后 60 秒且 mid <0.50 → 清仓
STOP_LOSS_FINAL_MID=0.50

# ── 订单 / GTD ──────────────────────────────────────────────────────────
GTD_LIFETIME_S=300              # CLOB 硬下限 180，客户端会钳制到 >=181
TAKER_FEE_RATE=0.07             # Taker 手续费率 fee=C×rate×p×(1-p)，maker 免费
TIER_WATCHER_POLL_S=1.5         # WS 漏事件时的 REST 兜底轮询
SELL_SLIPPAGE_PCT=0.02          # 仅 FAK 卖出路径使用（当前 TP 走 GTD）

# ── GTD 安全开关（实盘建议保持）─────────────────────────────────────────
VERIFY_NO_EXISTING_ORDER=true   # 下单前核对同价在途单，防止孤儿重复单；不要关闭
# 专用钱包保持 true（启动时清掉该账户全部挂单）；
# 若同一 API Key / Safe 还跑着其它机器人或手工单，务必改 false。
STARTUP_RECONCILE_CANCEL_ALL=true

# ── 可选：数据路径 ──────────────────────────────────────────────────────
# 默认 <项目根目录>/data/polymarket.db；Docker 下为 /app/data/polymarket.db
# POLYMARKET_DATA_DIR=./data
# POLYMARKET_DB_PATH=./data/polymarket.db

# ── Web 看板（FastAPI，监听 8010）───────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8010
WEB_USERNAME=admin
# 留空 = 只读看板公开，但配置页始终需要登录（没有密码就无法登录）
WEB_PASSWORD=
# 登录会话有效期（秒），默认 7 天
WEB_SESSION_TTL_S=604800
